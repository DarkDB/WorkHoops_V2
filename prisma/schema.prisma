generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  role                  UserRole               @default(jugador)
  locale                String                 @default("es")
  verified              Boolean                @default(false)
  planType              String                 @default("free_amateur")
  planStart             DateTime?
  planEnd               DateTime?
  isActive              Boolean                @default(true)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  passwordHash          String?
  passwordUpdatedAt     DateTime?              @db.Timestamp(6)
  failedLoginAttempts   Int                    @default(0)
  lockedUntil           DateTime?              @db.Timestamp(6)
  mustResetPassword     Boolean                @default(false)
  accounts              Account[]
  applications          Application[]
  clubAgencyProfile     ClubAgencyProfile?
  receivedClubLeads     ClubLead[]             @relation("ClubLeadClubUser")
  submittedClubLeads    ClubLead[]             @relation("ClubLeadSourceUser")
  coachProfile          CoachProfile?
  emailEvents           EmailEvent[]
  emailPreferences      EmailPreference[]
  emailSubscriptions    EmailSubscription[]
  favorites             Favorite[]
  funnelEvents          FunnelEvent[]
  interestNotifications InterestNotification[]
  notifications         Notification[]
  opportunities         Opportunity[]
  organizations         Organization[]
  otpTokens             OtpToken[]
  profileViewsReceived  ProfileView[]          @relation("ProfileViews")
  profileViewsMade      ProfileView[]          @relation("ViewsMade")
  resources             Resource[]
  sessions              Session[]
  sentTalentInvitations TalentInvitation[]
  talentProfile         TalentProfile?
  talentShortlists      TalentShortlist[]

  @@map("users")
}

model OtpToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("otp_tokens")
}

model Organization {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  website       String?
  logo          String?
  verified      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  ownerId       String
  opportunities Opportunity[]
  owner         User          @relation(fields: [ownerId], references: [id], onUpdate: NoAction)

  @@map("organizations")
}

model Opportunity {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  description      String
  type             OpportunityType
  level            OpportunityLevel
  status           OpportunityStatus @default(borrador)
  city             String?
  country          String            @default("España")
  latitude         Float?
  longitude        Float?
  modality         Modality          @default(presencial)
  remunerationType String?
  remunerationMin  Int?
  remunerationMax  Int?
  currency         String            @default("EUR")
  benefits         String?
  deadline         DateTime?
  startDate        DateTime?
  endDate          DateTime?
  publishedAt      DateTime?
  tags             String?
  verified         Boolean           @default(false)
  contactEmail     String
  contactPhone     String?
  applicationUrl   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  organizationId   String?
  authorId         String
  applications     Application[]
  favorites        Favorite[]
  author           User              @relation(fields: [authorId], references: [id], onUpdate: NoAction)
  organization     Organization?     @relation(fields: [organizationId], references: [id], onUpdate: NoAction)

  @@map("opportunities")
}

model Application {
  id            String           @id @default(cuid())
  state         ApplicationState @default(enviada)
  message       String?
  metadata      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  userId        String
  opportunityId String
  opportunity   Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User             @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([userId, opportunityId])
  @@map("applications")
}

model Favorite {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  userId        String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User        @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([userId, opportunityId])
  @@map("favorites")
}

model TalentProfile {
  id                          String                 @id @default(cuid())
  fullName                    String
  birthDate                   DateTime?
  role                        String
  city                        String
  country                     String                 @default("España")
  position                    String?
  height                      Int?
  weight                      Int?
  bio                         String?
  videoUrl                    String?
  socialUrl                   String?
  isPublic                    Boolean                @default(true)
  verified                    Boolean                @default(false)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  userId                      String                 @unique
  secondaryPosition           String?
  wingspan                    Int?
  dominantHand                String?
  currentLevel                String?
  lastTeam                    String?
  currentCategory             String?
  playingStyle                String?
  languages                   String?
  willingToTravel             Boolean?               @default(false)
  weeklyCommitment            Int?
  internationalExperience     Boolean?               @default(false)
  hasLicense                  Boolean?               @default(false)
  injuryHistory               String?
  currentGoal                 String?
  fullGameUrl                 String?
  photoUrls                   String?
  profileCompletionPercentage Int?                   @default(0)
  availabilityStatus          AvailabilityStatus     @default(OPEN_TO_OFFERS)
  availableFrom               DateTime?
  availabilityUpdatedAt       DateTime?
  interestNotifications       InterestNotification[]
  playerSkills                PlayerSkills?
  invitations                 TalentInvitation[]
  user                        User                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "talent_profiles_userid_fkey")
  shortlists                  TalentShortlist[]

  @@index([isPublic], map: "talent_profiles_ispublic_idx")
  @@index([role])
  @@index([userId], map: "talent_profiles_userid_idx")
  @@map("talent_profiles")
}

model PlayerSkills {
  id                String        @id @default(cuid())
  talentProfileId   String        @unique
  threePointShot    Int           @default(3)
  midRangeShot      Int           @default(3)
  finishing         Int           @default(3)
  ballHandling      Int           @default(3)
  playmaking        Int           @default(3)
  offBallMovement   Int           @default(3)
  individualDefense Int           @default(3)
  teamDefense       Int           @default(3)
  offensiveRebound  Int           @default(3)
  defensiveRebound  Int           @default(3)
  speed             Int           @default(3)
  athleticism       Int           @default(3)
  endurance         Int           @default(3)
  leadership        Int           @default(3)
  decisionMaking    Int           @default(3)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  talentProfile     TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@map("player_skills")
}

model CoachProfile {
  id                          String    @id @default(cuid())
  userId                      String    @unique
  fullName                    String
  birthYear                   Int?
  nationality                 String?   @default("España")
  languages                   String?
  city                        String
  willingToRelocate           Boolean?  @default(false)
  currentLevel                String?
  federativeLicense           String?
  totalExperience             Int?
  currentClub                 String?
  previousClubs               String?
  categoriesCoached           String?
  achievements                String?
  internationalExp            Boolean?  @default(false)
  internationalExpDesc        String?
  roleExperience              String?
  nationalTeamExp             Boolean?  @default(false)
  trainingPlanning            Int?      @default(3)
  individualDevelopment       Int?      @default(3)
  offensiveTactics            Int?      @default(3)
  defensiveTactics            Int?      @default(3)
  groupManagement             Int?      @default(3)
  scoutingAnalysis            Int?      @default(3)
  staffManagement             Int?      @default(3)
  communication               Int?      @default(3)
  tacticalAdaptability        Int?      @default(3)
  digitalTools                Int?      @default(3)
  physicalPreparation         Int?      @default(3)
  youthDevelopment            Int?      @default(3)
  playingStyle                String?
  workPriority                String?
  playerTypePreference        String?
  inspirations                String?
  academicDegrees             String?
  certifications              String?
  coursesAttended             String?
  currentGoal                 String?
  offerType                   String?
  availability                String?
  leadership                  Int?      @default(3)
  teamwork                    Int?      @default(3)
  conflictResolution          Int?      @default(3)
  organization                Int?      @default(3)
  adaptability                Int?      @default(3)
  innovation                  Int?      @default(3)
  videoUrl                    String?
  presentationsUrl            String?
  photoUrls                   String?
  bio                         String?
  isPublic                    Boolean?  @default(true)
  verified                    Boolean?  @default(false)
  profileCompletionPercentage Int?      @default(0)
  createdAt                   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt                   DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([city])
  @@index([currentLevel])
  @@index([isPublic])
  @@index([userId])
  @@map("coach_profiles")
}

model ClubAgencyProfile {
  id                          String     @id @default(cuid())
  userId                      String     @unique
  legalName                   String
  entityType                  String
  foundedYear                 Int?
  description                 String?
  logo                        String?
  coverImage                  String?
  country                     String     @default("España")
  city                        String
  address                     String?
  categories                  String[]   @default([])
  divisions                   String[]   @default([])
  contactPerson               String?
  contactEmail                String?
  contactPhone                String?
  website                     String?
  facebookUrl                 String?
  twitterUrl                  String?
  instagramUrl                String?
  linkedinUrl                 String?
  facilities                  String?
  achievements                String?
  isPublic                    Boolean    @default(true)
  verified                    Boolean    @default(false)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @default(now()) @updatedAt
  commercialName              String?
  province                    String?
  youtubeUrl                  String?
  competitions                String?
  sections                    String?
  rosterSize                  Int?
  staffSize                   Int?
  workingLanguages            String?
  contactRole                 String?
  fiscalDocument              String?
  contactPreference           String?
  profilesNeeded              String?
  ageRangeMin                 Int?
  ageRangeMax                 Int?
  minHeightByPosition         String?
  experienceRequired          String?
  competitiveReqs             String?
  keySkills                   String?
  availabilityNeeded          String?
  salaryRange                 String?
  housingProvided             Boolean?   @default(false)
  mealsTransport              Boolean?   @default(false)
  medicalInsurance            Boolean?   @default(false)
  contractType                String?
  visaSupport                 Boolean?   @default(false)
  requiredDocs                String?
  agentPolicy                 String?
  scoutingNotes               String?
  facilityPhotos              String?
  institutionalVideo          String?
  showEmailPublic             Boolean?   @default(false)
  showPhonePublic             Boolean?   @default(false)
  candidatesViaPortal         Boolean?   @default(true)
  profileCompletionPercentage Int?       @default(0)
  slug                        String?    @unique
  user                        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads                       ClubLead[]

  @@index([city])
  @@index([entityType])
  @@index([verified])
  @@map("club_agency_profiles")
}

model ClubLead {
  id            String            @id @default(cuid())
  clubUserId    String
  clubProfileId String
  fullName      String
  age           Int?
  position      String?
  height        Int?
  city          String?
  email         String
  phone         String?
  message       String?
  status        ClubLeadStatus    @default(NEW)
  sourceUserId  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  clubProfile   ClubAgencyProfile @relation(fields: [clubProfileId], references: [id], onDelete: Cascade)
  clubUser      User              @relation("ClubLeadClubUser", fields: [clubUserId], references: [id], onDelete: Cascade)
  sourceUser    User?             @relation("ClubLeadSourceUser", fields: [sourceUserId], references: [id])

  @@index([clubUserId, createdAt])
  @@index([clubProfileId, status])
  @@index([sourceUserId, createdAt])
  @@map("club_leads")
}

model InterestNotification {
  id               String        @id @default(cuid())
  profileId        String
  interestedUserId String
  message          String?
  status           String        @default("pending")
  createdAt        DateTime      @default(now())
  interestedUser   User          @relation(fields: [interestedUserId], references: [id], onDelete: Cascade)
  talentProfile    TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([interestedUserId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("interest_notifications")
}

model TalentShortlist {
  id              String               @id @default(cuid())
  clubUserId      String
  talentProfileId String
  status          TalentPipelineStatus @default(SAVED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lastStatusAt    DateTime?
  invitations     TalentInvitation[]
  clubUser        User                 @relation(fields: [clubUserId], references: [id], onDelete: Cascade)
  talentProfile   TalentProfile        @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@unique([clubUserId, talentProfileId])
  @@index([clubUserId, status])
  @@index([talentProfileId])
  @@map("talent_shortlists")
}

model TalentInvitation {
  id              String             @id @default(cuid())
  shortlistId     String?
  clubUserId      String
  talentProfileId String
  type            TalentInviteType
  status          TalentInviteStatus @default(SENT)
  message         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  respondedAt     DateTime?
  clubUser        User               @relation(fields: [clubUserId], references: [id], onDelete: Cascade)
  shortlist       TalentShortlist?   @relation(fields: [shortlistId], references: [id])
  talentProfile   TalentProfile      @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@index([clubUserId, createdAt])
  @@index([talentProfileId, createdAt])
  @@index([status])
  @@map("talent_invitations")
}

model Resource {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  excerpt         String
  content         String
  category        ResourceCategory
  status          ResourceStatus   @default(draft)
  featured        Boolean          @default(false)
  featuredImage   String?
  author          String
  readTime        Int              @default(5)
  views           Int              @default(0)
  metaTitle       String?
  metaDescription String?
  userId          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
  @@index([userId])
  @@map("resources")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model FunnelEvent {
  id        String   @id @default(cuid())
  eventName String
  userId    String?
  role      String?
  metadata  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@map("funnel_events")
}

model EmailPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String
  enabled   Boolean  @default(true)
  frequency String   @default("immediate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("email_preferences")
}

model ProfileView {
  id            String   @id @default(cuid())
  profileUserId String
  viewerIp      String?
  viewerUserId  String?
  profileType   String
  createdAt     DateTime @default(now())
  profileUser   User     @relation("ProfileViews", fields: [profileUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  viewer        User?    @relation("ViewsMade", fields: [viewerUserId], references: [id], onUpdate: NoAction)

  @@index([profileUserId, createdAt])
  @@index([viewerIp, profileUserId, createdAt])
  @@map("profile_views")
}

model EmailEvent {
  id        String    @id @default(cuid())
  userId    String?
  email     String
  template  String
  category  String
  dedupeKey String?
  status    String
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId, category, createdAt])
  @@index([email, template, createdAt])
  @@index([dedupeKey])
  @@map("email_events")
}

/// This table has RLS and no runtime callers today, but remains part of the physical baseline.
model EmailSubscription {
  id        String   @id
  email     String
  filters   String
  frequency String   @default("daily")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("email_subscriptions")
}

enum UserRole {
  admin
  jugador
  entrenador
  club
  agencia
}

enum OpportunityType {
  empleo
  prueba
  torneo
  clinica
  beca
  patrocinio
}

enum OpportunityStatus {
  borrador
  pendiente
  publicada
  cerrada
  suspendida
}

enum OpportunityLevel {
  amateur
  semi_profesional
  profesional
  cantera
}

enum Modality {
  presencial
  online
  mixta
}

enum ApplicationState {
  enviada
  en_revision
  aceptada
  rechazada
  finalizada
}

enum ResourceStatus {
  draft
  published
}

enum ResourceCategory {
  preparacion
  carrera
  recursos
  salud
  tactica
  mental
}

enum AvailabilityStatus {
  AVAILABLE
  OPEN_TO_OFFERS
  NOT_AVAILABLE
}

enum TalentPipelineStatus {
  SAVED
  CONTACTED
  INVITED
  SIGNED
  REJECTED
}

enum TalentInviteType {
  INVITE_TO_APPLY
  INVITE_TO_TRYOUT
}

enum TalentInviteStatus {
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

enum ClubLeadStatus {
  NEW
  REVIEWED
  CONTACTED
  REJECTED
}
